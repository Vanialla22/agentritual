# AgentRitual — environment placeholders. Copy to the right place and fill in.
# NEVER commit a filled-in copy. NEVER paste a real private key here.
#
# API (apps/api/.env):
#   PORT=3001
#   DATABASE_PATH=./data/agentritual.db
#   BSC_RPC_URL=https://bsc.publicnode.com
#   NFT_CONTRACT_ADDRESS=
#   NFT_CHAIN_ID=97  (97 = BSC testnet, 56 = BSC mainnet)
#   AGENT_ID_REGISTRY_ADDRESS=  (mainnet 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F;
#     testnet: the mock registry address from the Phase 2 deployment)
#   ADMIN_SIGNER_PRIVATE_KEY=
#   ADMIN_PASSWORD_HASH=   (generate: ADMIN_PASSWORD='...' npm run admin:hash)
#   ADMIN_SESSION_SECRET=  (random 32+ bytes; HMAC-signs admin sessions, 2 h)
#   AUTH_SECRET=           (optional; defaults to ADMIN_SESSION_SECRET; HMAC for ownership challenges/proof tokens)
#   ADMIN_WALLET=          (admin's own wallet; enables the self-approval block)
#   NFT_DEPLOY_BLOCK=      (first block of the NFT contract; testnet 143587234; 0 = trailing 5,000-block window)
#   RATE_LIMIT_SUBMISSIONS_PER_WALLET_HOUR=5
#   RATE_LIMIT_SUBMISSIONS_PER_IP_HOUR=20
#   RATE_LIMIT_LOGIN_PER_IP_15MIN=5
#   RATE_LIMIT_ELIGIBILITY_PER_IP_MIN=60
#   RATE_LIMIT_CHALLENGE_PER_IP_MIN=10
#
# Turso (optional, replaces the local SQLite file when set):
#   TURSO_DATABASE_URL=libsql://your-db-....turso.io
#   TURSO_AUTH_TOKEN=
#
# Web (apps/web/.env):
#   VITE_API_URL=http://localhost:3001
