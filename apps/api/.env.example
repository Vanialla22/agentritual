# API env — placeholders only. Copy to .env and fill in. Never commit a filled-in copy.
# Never paste a real private key into any file.
PORT=3001
DATABASE_PATH=./data/agentritual.db
BSC_RPC_URL=https://bsc.publicnode.com
NFT_CONTRACT_ADDRESS=
# Chain the API talks to: 97 = BSC testnet, 56 = BSC mainnet (default 97).
# The EIP-712 voucher domain uses this chainId (audit M-2).
NFT_CHAIN_ID=97
# Agent ID registry for balanceOf checks. Mainnet:
# 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F. Testnet: the mock registry
# address from the Phase 2 deployment. Empty = eligibility checks fail
# closed with 503.
AGENT_ID_REGISTRY_ADDRESS=
NFT_IMAGE_URL=
# First block of the NFT contract (testnet 143587234). Required in production:
# set to the mainnet deploy block at deploy time. When unset, mint-audit scans
# only the trailing 5,000 blocks and answers windowTruncated: true — a
# "0 anomalies" answer from a truncated scan is NOT a clean bill.
NFT_DEPLOY_BLOCK=
ADMIN_SIGNER_PRIVATE_KEY=
ADMIN_PASSWORD_HASH=
# Random 32+ bytes; HMAC-signs admin sessions (2 h). AUTH_SECRET defaults
# to this value. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Admin's own wallet; enables the server-side self-approval block.
ADMIN_WALLET=
# Comma-separated campaigns that accept submissions/reviews/vouchers.
# Default 001. An explicitly empty value disables ALL campaigns.
AUTHORIZED_CAMPAIGNS=001
# Tx hashes of historical test mints, classified "known-test" by mint-audit.
# Default covers testnet tokens #0–#2. Leave EMPTY on mainnet — any mainnet
# mint without a voucher must show as an anomaly.
KNOWN_TEST_MINT_TX_HASHES=
# CORS_ORIGIN=http://localhost:5173
# Turso (optional — when set, replaces the local SQLite file):
# TURSO_DATABASE_URL=libsql://your-db-....turso.io
# TURSO_AUTH_TOKEN=
